# ==========================================
# CloudVault — Environment Configuration
# ==========================================

# Server
NODE_ENV=development
PORT=3000

# MongoDB Database URI (MongoDB Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/cloudvault?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cloudvault

# Redis Cache & Queues (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secure_access_token_secret_key_cloudvault_2026_at_least_32_chars
REFRESH_TOKEN_SECRET=super_secure_refresh_token_secret_key_cloudvault_2026_at_least_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# TOTP & WebAuthn / Passkeys
WEBAUTHN_RP_NAME=CloudVault
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# S3 / MinIO Private Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword
S3_BUCKET=cloudvault-media
S3_FORCE_PATH_STYLE=true

# Python Media & AI Worker Service
PYTHON_SERVICE_URL=http://localhost:8000

# Client & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_LIMIT=10

# Storage Quota Default (15 GB in bytes)
DEFAULT_STORAGE_QUOTA_BYTES=16106127360

# Trash Retention (days)
TRASH_RETENTION_DAYS=30
